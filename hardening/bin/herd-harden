#!/bin/sh
# =============================================================================
# herd-harden: one-command hardening for CapivaraOS HERD (OpenSCAP + Ansible)
# =============================================================================
# Applies a Fedora SCAP Security Guide (SSG) profile to the system, using the
# Ansible playbooks that oscap itself generates (fix-type ansible). It is the
# "apply" counterpart of herd-compliance-scan, which only reports.
#
# SAFETY: runs as a DRY-RUN by default (ansible-playbook --check --diff) and
# changes NOTHING. It applies only with an explicit --apply.
#
# Usage:
#   herd-harden [PROFILE]               # dry-run: shows what would change (default)
#   sudo herd-harden [PROFILE] --apply  # applies the profile
#   herd-harden --list                  # lists the available profiles
#   herd-harden --help
#
# PROFILE accepts a short alias or the full SSG profile id:
#   standard   (default) -> HERD Community baseline
#   ospp                 -> Protection Profile (NIAP/CC)
#   cis-l1               -> CIS Fedora Level 1 Server (SSG, unofficial)
#   cis-l2  (or cis)     -> CIS Fedora Level 2 Server (SSG, unofficial)
#   pci     (or pci-dss) -> PCI-DSS v3.2.1
#
# Compliance note: the CIS profiles here are the SSG's own versions for Fedora (CIS
# publishes no official Fedora benchmark); there is no STIG profile for
# Fedora (use ospp as a DoD-adjacent baseline). HERD Community delivers the
# controls and the evidence: "compliance-ready", never "certified".
# =============================================================================
set -eu

DS_STD=/usr/share/xml/scap/ssg/content/ssg-fedora-ds.xml
DS_VENDORED=/usr/share/capivaraos-herd-hardening/ssg-fedora-ds.xml
PREFIX=xccdf_org.ssgproject.content_profile_
DEFAULT_PROFILE=standard

resolve_profile() {
    case "$1" in
        standard)             echo "${PREFIX}standard" ;;
        ospp)                 echo "${PREFIX}ospp" ;;
        cis-l1|cis_server_l1) echo "${PREFIX}cis_server_l1" ;;
        cis-l2|cis)           echo "${PREFIX}cis" ;;
        pci|pci-dss)          echo "${PREFIX}pci-dss" ;;
        ${PREFIX}*)           echo "$1" ;;   # id técnico completo
        *)                    return 1 ;;
    esac
}

usage() {
    cat <<'EOF'
herd-harden — fortalecimento em 1 comando (OpenSCAP + Ansible) / one-command hardening

  herd-harden [PERFIL]              dry-run: mostra o que mudaria (não altera nada)
  sudo herd-harden [PERFIL] --apply aplica o perfil de verdade
  herd-harden --list               lista os perfis do datastream
  herd-harden --help

PERFIL / PROFILE:
  standard (padrão) · ospp · cis-l1 · cis-l2 (cis) · pci (pci-dss)
  ou o id técnico completo (xccdf_org.ssgproject.content_profile_*)

Sem --apply, roda em modo verificação (--check): seguro para inspecionar.
Without --apply, runs in Ansible check mode: safe, changes nothing.
EOF
}

# ---- datastream discovery (same rule as herd-compliance-scan) ----------------
if [ -r "$DS_STD" ]; then
    DS="$DS_STD"
elif [ -r "$DS_VENDORED" ]; then
    DS="$DS_VENDORED"
else
    echo "erro: datastream SCAP não encontrado." >&2
    echo "       Instale: dnf install scap-security-guide" >&2
    exit 1
fi

# ---- argument parsing --------------------------------------------------------
APPLY=0
PROFILE_IN=""
for a in "$@"; do
    case "$a" in
        --apply)     APPLY=1 ;;
        --list|-l)
            if command -v oscap >/dev/null 2>&1; then
                oscap info "$DS" | grep -i 'profile' || true
            else
                echo "perfis (apelidos): standard, ospp, cis-l1, cis-l2, pci"
            fi
            exit 0 ;;
        -h|--help)   usage; exit 0 ;;
        -*)          echo "erro: opção desconhecida: $a" >&2; usage >&2; exit 2 ;;
        *)           PROFILE_IN="$a" ;;
    esac
done
[ -n "$PROFILE_IN" ] || PROFILE_IN="$DEFAULT_PROFILE"

PROFILE="$(resolve_profile "$PROFILE_IN")" || {
    echo "erro: perfil desconhecido: $PROFILE_IN" >&2
    echo "      use --list, ou um de: standard ospp cis-l1 cis-l2 pci" >&2
    exit 2
}

# ---- dependencies ------------------------------------------------------------
command -v oscap >/dev/null 2>&1 || {
    echo "erro: 'oscap' não encontrado. Instale: dnf install openscap-scanner" >&2; exit 1; }
command -v ansible-playbook >/dev/null 2>&1 || {
    echo "erro: 'ansible-playbook' não encontrado. Instale: dnf install ansible-core" >&2; exit 1; }

# Both --check and --apply read or change system files: needs root.
[ "$(id -u)" -eq 0 ] || { echo "erro: rode como root (sudo herd-harden ...)." >&2; exit 1; }

# ---- remediation playbook (generated on demand from the datastream) ----------
TS="$(date +%Y%m%d-%H%M%S)"
PLAYBOOK="$(mktemp /tmp/herd-harden-XXXXXX.yml)"
LOG="/var/log/herd-harden-${TS}.log"
trap 'rm -f "$PLAYBOOK"' EXIT

echo "==> CapivaraOS HERD — fortalecimento por perfil"
echo "    perfil:     ${PROFILE}"
echo "    datastream: ${DS}"
echo

# oscap exits 1 when there is nothing to remediate; not a fatal error here.
oscap xccdf generate fix --fix-type ansible --profile "$PROFILE" \
    --output "$PLAYBOOK" "$DS" || true
if [ ! -s "$PLAYBOOK" ]; then
    echo "erro: não foi possível gerar o playbook para o perfil '${PROFILE}'." >&2
    exit 1
fi

# Local inventory: applies to this machine, without SSH.
AP_ARGS="-i localhost, -c local -e ansible_python_interpreter=/usr/bin/python3"

# shellcheck disable=SC2086
if [ "$APPLY" -eq 1 ]; then
    echo "!!  MODO --apply: as mudanças do perfil serão APLICADAS neste servidor."
    echo "    Log: ${LOG}"
    echo
    ansible-playbook $AP_ARGS "$PLAYBOOK" 2>&1 | tee "$LOG"
    echo
    # Access warning: stricter profiles (ospp/cis) switch the system crypto-policy
    # to FIPS mode, which INVALIDATES ed25519 SSH keys and ciphers outside the
    # FIPS set; a new login may be refused. Shows the current policy and asks first.
    POL="$(update-crypto-policies --show 2>/dev/null || true)"
    cat <<EOF

============================================================
  ATENÇÃO — confirme o acesso ANTES de encerrar esta sessão
============================================================
  Este perfil pode ter mudado a política de criptografia do
  sistema (crypto-policy atual: ${POL:-desconhecida}).
  Sob FIPS, chaves SSH ed25519 deixam de ser aceitas.
  -> Abra uma NOVA sessao SSH agora, de preferencia com chave
     RSA ou ECDSA, e confirme que loga -- sem fechar esta.
============================================================
EOF
    echo "==> Concluído. Rode 'sudo herd-compliance-scan ${PROFILE_IN}' para conferir o score."
else
    echo ">>  DRY-RUN (verificação, nada será alterado). Use --apply para aplicar."
    echo "    Log: ${LOG}"
    echo
    ansible-playbook $AP_ARGS --check --diff "$PLAYBOOK" 2>&1 | tee "$LOG"
    echo
    echo "==> Isto foi um dry-run. Para aplicar: sudo herd-harden ${PROFILE_IN} --apply"
fi
