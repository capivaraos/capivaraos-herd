# CapivaraOS Herd: signed update repository.
#
# Lets an installed Herd receive the capivaraos-herd-* packages (including
# herd-harden and herd-compliance-scan) and their security fixes, in addition
# to the Fedora updates.
#
# Trust comes from the signature, not from the host: gpgcheck and
# repo_gpgcheck refuse any package or metadata not signed by one of the two
# Herd keys listed in gpgkey=, so a modified package or index from a
# compromised server is rejected. Only the public keys ship in this package.
# See keys/README.md.
#
# $releasever is the Fedora base release (from fedora-release), not the
# os-release VERSION_ID. With `dnf system-upgrade --releasever=46` it becomes
# 46 and the baseurl follows to f46/ without editing this file.

# skip_if_unavailable=1: this repository must not stop the system's dnf. If
# repo-herd.capivaraos.org is down, or has no f<ver>/ yet, dnf skips it with a
# warning instead of aborting the whole transaction, so dnf5-automatic still
# applies the Fedora updates. Authenticity is unaffected (gpgcheck and
# repo_gpgcheck above); this only affects availability.
[capivaraos-herd]
name=CapivaraOS Herd $releasever - $basearch
baseurl=https://repo-herd.capivaraos.org/f$releasever/$basearch/stable/
enabled=1
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-capivaraos-herd file:///etc/pki/rpm-gpg/RPM-GPG-KEY-capivaraos-herd-reserve
metadata_expire=6h

# Pre-release channel for QA, disabled by default. A tester enables it with
# `dnf --enablerepo=capivaraos-herd-testing update`. A fix promoted to stable
# leaves this channel.
[capivaraos-herd-testing]
name=CapivaraOS Herd $releasever - $basearch - Testing
baseurl=https://repo-herd.capivaraos.org/f$releasever/$basearch/testing/
enabled=0
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-capivaraos-herd file:///etc/pki/rpm-gpg/RPM-GPG-KEY-capivaraos-herd-reserve
metadata_expire=6h
